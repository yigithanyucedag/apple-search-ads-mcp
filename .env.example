# Apple Search Ads API credentials.
# Get these from https://app.searchads.apple.com → Account Settings → API.
#
# 1) Create an API user, download the .p8 private key.
# 2) Note the Client ID and Team ID from the same page.
# 3) Set these env vars (or pass them as args via your MCP client config).

# Required: OAuth client credentials
ASA_CLIENT_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASA_TEAM_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASA_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Required: ES256 private key. EITHER pass the PEM contents inline...
# ASA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGHAg...\n-----END PRIVATE KEY-----"
# ...OR point at a file on disk:
ASA_PRIVATE_KEY_PATH=/absolute/path/to/private-key.p8

# Required: the org (account) you want to operate against.
# Use the org_acls tool to discover orgIds you have access to.
ASA_ORG_ID=1234567

# Optional: override defaults
# ASA_API_BASE_URL=https://api.searchads.apple.com/api/v5
# ASA_TOKEN_URL=https://appleid.apple.com/auth/oauth2/token
# ASA_TOKEN_AUDIENCE=https://appleid.apple.com
